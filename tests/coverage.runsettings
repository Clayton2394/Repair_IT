<?xml version="1.0" encoding="utf-8"?>
<!-- Paramètres de couverture partagés par tous les projets de tests (voir tests/Directory.Build.props). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Code généré par le compilateur / les source generators et points d'entrée (Program.cs) -->
          <ExcludeByFile>**/obj/**/*.cs,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
