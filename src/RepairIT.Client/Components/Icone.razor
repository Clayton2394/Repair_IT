        case "alerte":
            <path d="M12 3 2 20h20z" /><path d="M12 10v4" /><path d="M12 17h.01" />
            break;
        case "stock":
            <path d="M21 8 12 3 3 8v8l9 5 9-5z" /><path d="M3 8l9 5 9-5" /><path d="M12 13v8" />
            break;
        case "euro":
            <path d="M18 6a7 7 0 1 0 0 12" /><path d="M4 10h10" /><path d="M4 14h10" />
            break;
        case "bouclier":
            <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Nom { get; set; } = string.Empty;
    [Parameter] public int Taille { get; set; } = 20;
}
